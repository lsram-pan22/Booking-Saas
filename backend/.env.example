APP_PORT=8080
GIN_MODE=release
DB_HOST=localhost
DB_PORT=5432
DB_NAME=booking_saas
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-password
DB_SCHEMA=public
DB_SSLMODE=disable
JWT_SECRET=replace-with-a-long-random-secret
# Generate a unique random JWT secret of at least 32 bytes before starting.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave empty for direct connections; only list the actual reverse proxy peers.
TRUSTED_PROXIES=
