# PostgreSQL connection settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=booking_saas
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-password

# Generate a unique random JWT secret of at least 32 bytes before starting.
JWT_SECRET=replace-with-a-long-random-secret

# Uncomment these settings to override the local defaults.
# APP_PORT=8080
# GIN_MODE=release
# DB_SCHEMA=public
# DB_SSLMODE=disable
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set only when using a reverse proxy. List its IP addresses or CIDR ranges.
# TRUSTED_PROXIES=
